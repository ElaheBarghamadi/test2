{
  "name": "examora-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-stack.mjs --web-only",
    "dev:turbo": "node scripts/dev-stack.mjs --web-only --turbo",
    "dev:web": "node scripts/dev-stack.mjs --web-only",
    "dev:api": "node scripts/dev-stack.mjs --api-only",
    "dev:stack": "node scripts/dev-stack.mjs",
    "dev:stack:turbo": "node scripts/dev-stack.mjs --turbo",
    "setup": "node scripts/dev-stack.mjs --setup-only",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
