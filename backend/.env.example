# Copy this file to backend/.env for local development. Never commit backend/.env.
DJANGO_SECRET_KEY=replace-with-a-long-unique-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank for the local SQLite development database.
DATABASE_URL=
# PostgreSQL is the intended shared/production database:
# DATABASE_URL=postgresql://examora:change-me@127.0.0.1:5432/examora

# Comma-separated origins; do not use * in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Password reset links and email delivery. Console email is local-development only.
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=noreply@example.com
# Production SMTP example (keep credentials out of source control):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=...
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=true
