# Browser-visible API base. A relative value keeps browser requests same-origin and uses
# the optional Next.js development proxy below; a deployed absolute HTTPS API is also valid.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Server-only local/proxy target. Do not prefix this with NEXT_PUBLIC_ and never store secrets here.
API_PROXY_TARGET=http://127.0.0.1:8000

# Production alternative when the API is publicly served over HTTPS:
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
